{
  "expo": {
    "name": "LiveClass Caption",
    "slug": "liveclass-caption",
    "scheme": "liveclasscaption",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liveclasscaption.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow LiveClass Caption to use the microphone to generate live captions.",
        "NSSpeechRecognitionUsageDescription": "Allow LiveClass Caption to use speech recognition to generate live captions."
      }
    },
    "android": {
      "package": "com.liveclasscaption.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LiveClass Caption to use the microphone to generate live captions.",
          "speechRecognitionPermission": "Allow LiveClass Caption to use speech recognition to generate live captions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c8872763-4bcc-42f6-9242-7363692a0b26"
      }
    }
  }
}
